*.acm
*.int
*.egm
*.egt
*.tri
*.bik
*.ogg
*.wav
*.sqlite
*.glb

# Pipeline output directories, at the root and wherever --out points
# inside the tree. crates/mir is source and is not matched by /mir/.
/mir/
/mods/
/output/
/out/
**/mods/mojave/
report.md
